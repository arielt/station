# usage: tools/deploy [--app] [project]
APP_ONLY=0
PROJECT=""
for arg in "$@"; do
  case "$arg" in
    --app|-app)
      APP_ONLY=1
      ;;
    -*)
      echo "unknown flag: $arg" >&2
      exit 1
      ;;
    *)
      PROJECT="$arg"
      ;;
  esac
done
PROJECT="${PROJECT:-google-sheet-demo}"
export PROJECT

COMPOSE="docker compose -f deployments/dev/docker-compose.yml"

if [ "$APP_ONLY" = 1 ]; then
  $COMPOSE build --build-arg PROJECT="$PROJECT" app
  $COMPOSE up --detach --no-deps --force-recreate app
  exit 0
fi

$COMPOSE stop
$COMPOSE pull
$COMPOSE build --build-arg PROJECT="$PROJECT"
$COMPOSE up --detach

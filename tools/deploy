# usage: tools/deploy [--app] [app name]
APP_ONLY=0
STATION_APP=""
STATION_ENV="development"

for arg in "$@"; do
  case "$arg" in
    --app|-app)
      APP_ONLY=1
      ;;
    -*)
      echo "unknown flag: $arg" >&2
      exit 1
      ;;
    *)
      STATION_APP="$arg"
      ;;
  esac
done
STATION_APP="${STATION_APP:-google-sheet-demo}"
export STATION_APP

COMPOSE="docker compose -f deployments/$STATION_ENV/docker-compose.yml"

if [ "$APP_ONLY" = 1 ]; then
  $COMPOSE build --build-arg STATION_APP="$STATION_APP" app
  $COMPOSE up --detach --no-deps --force-recreate app
  exit 0
fi

$COMPOSE stop
$COMPOSE pull
$COMPOSE build --build-arg STATION_APP="$STATION_APP"
$COMPOSE up --detach

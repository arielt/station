# usage: tools/deploy [--app]
# STATION_APP is the path to the app root.
APP_ONLY=0
STATION_ENV="development"

for arg in "$@"; do
  case "$arg" in
    --app|-app)
      APP_ONLY=1
      ;;
    *)
      echo "unknown argument: $arg" >&2
      exit 1
      ;;
  esac
done

if [ -z "${STATION_APP}" ]; then
  echo "STATION_APP must be set to the app root path" >&2
  exit 1
fi
export STATION_APP

COMPOSE="docker compose -f deployments/$STATION_ENV/docker-compose.yml"

if [ "$APP_ONLY" = 1 ]; then
  $COMPOSE build --build-arg STATION_APP="$STATION_APP" app
  $COMPOSE up --detach --no-deps --force-recreate app
  exit 0
fi

$COMPOSE stop
$COMPOSE pull
$COMPOSE build --build-arg STATION_APP="$STATION_APP"
$COMPOSE up --detach

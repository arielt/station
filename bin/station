#!/usr/bin/env python3
"""Create, deploy, and destroy a station project."""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

ENVIRONMENTS = ("development", "test", "production")
HOST_PORTS = {
    "development": {"app": 8888, "db": 5432, "vault": 8200},
    "test": {"app": 18888, "db": 15432, "vault": 18200},
    "production": {"app": 28888, "db": 25432, "vault": 28200},
}
DEFAULT_DB_IMAGE = "postgres:18"
DEFAULT_VAULT_IMAGE = "openbao/openbao:latest"
NAME_PATTERN = re.compile(r"[a-z][a-z0-9_]*")
IMAGE_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:/-]*")
KEY_PATTERN = re.compile(r"[A-Za-z][A-Za-z0-9_-]*")
GENERATED = "Generated by station from station.yaml. Do not edit."

USAGE = """\
usage: station create <path>
       station deploy
       station destroy
       station endpoints

STATION_ENV selects development, test, or production. The default is development.

  create <path>  Create an empty project, or regenerate project from station.yaml
  deploy         Deploy the project
  destroy        Remove all project containers, volumes and unused images
  endpoints      List endpoints for the current project
"""


class StationError(Exception):
    """A user-facing station failure."""


def main(argv: list[str]) -> int:
    if len(argv) == 1:
        print(USAGE, file=sys.stderr, end="")
        return 1
    command = argv[1]
    if command in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0
    try:
        if command == "create":
            if len(argv) != 3:
                raise StationError("usage: station create <path>")
        elif command == "deploy":
            if len(argv) != 2:
                raise StationError("usage: station deploy")
        elif command == "destroy":
            if len(argv) != 2:
                raise StationError("usage: station destroy")
        elif command == "endpoints":
            if len(argv) != 2:
                raise StationError("usage: station endpoints")
        else:
            raise StationError(f"unknown command: {command}")
        environment = selected_environment()
        print(f"STATION_ENV={environment}", flush=True)
        if command == "create":
            create(argv[2])
            return 0
        if command == "deploy":
            return deploy(environment)
        if command == "destroy":
            return destroy(environment)
        endpoints(environment)
        return 0
    except StationError as error:
        print(f"station: {error}", file=sys.stderr)
        return 1


def create(argument: str) -> None:
    display = argument.rstrip("/") or "."
    target = Path(argument)
    if not target.is_absolute():
        target = Path.cwd() / target
    target = target.resolve()
    manifest = target / "station.yaml"

    if manifest.is_file():
        config = load_config(manifest)
        generate(target, config)
        print(f"regenerated deployments for {config['name']}")
        return

    if target.exists():
        if not target.is_dir():
            raise StationError(f"{display}: not a directory")
        extras = [child.name for child in target.iterdir() if child.name != ".DS_Store"]
        if extras:
            raise StationError(f"{display}: directory exists and has no station.yaml")

    name = target.name
    validate_name(name, "project name")
    try:
        target.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise StationError(error.strerror or f"cannot create {display}") from error
    write_file(manifest, empty_manifest(name))
    generate(target, load_config(manifest))
    print(f"created {display}")


def deploy(environment: str) -> int:
    root = project_root()
    config = load_config(root / "station.yaml")
    compose_path = compose_file(root, environment)
    ensure_sources(root, config)
    print(f"deploying {config['name']} ({environment})", flush=True)
    return run_command(["docker", "compose", "-f", str(compose_path), "up", "--detach", "--build", "--remove-orphans"])


def endpoints(environment: str) -> None:
    config = load_config(project_root() / "station.yaml")
    ports = HOST_PORTS[environment]
    rows = [
        (name, "http", f"http://127.0.0.1:{ports['app'] + index}")
        for index, name in enumerate(config["apps"])
    ]
    rows.append(("vault", "http", f"http://127.0.0.1:{ports['vault']}"))
    rows.append(("db", "postgres", f"postgres://127.0.0.1:{ports['db']}"))
    name_width = max(len(name) for name, _, _ in rows)
    protocol_width = max(len(protocol) for _, protocol, _ in rows)
    for name, protocol, url in rows:
        print(f"{name:<{name_width}}  {protocol:<{protocol_width}}  {terminal_link(url)}", flush=True)


def terminal_link(url: str) -> str:
    if not sys.stdout.isatty():
        return url
    return f"\033]8;;{url}\033\\{url}\033]8;;\033\\"


def destroy(environment: str) -> int:
    root = project_root()
    config = load_config(root / "station.yaml")
    compose_path = compose_file(root, environment)
    print(f"destroying {config['name']} ({environment})", flush=True)
    return run_command([
        "docker", "compose", "-f", str(compose_path),
        "down", "--volumes", "--rmi", "all", "--remove-orphans",
    ])


def project_root() -> Path:
    root = Path.cwd()
    if not (root / "station.yaml").is_file():
        raise StationError("station.yaml not found in the current directory")
    return root


def selected_environment() -> str:
    value = os.environ.get("STATION_ENV", "").strip()
    if not value:
        return "development"
    if value not in ENVIRONMENTS:
        allowed = ", ".join(ENVIRONMENTS)
        raise StationError(f"STATION_ENV must be one of: {allowed}")
    return value


def compose_file(root: Path, environment: str) -> Path:
    path = root / "deployments" / environment / "docker-compose.yml"
    if not path.is_file():
        raise StationError(
            f"deployments/{environment}/docker-compose.yml not found. Run: station create ."
        )
    return path


def ensure_sources(root: Path, config: dict[str, Any]) -> None:
    missing = []
    for name, app in config["apps"].items():
        if app["git"]:
            continue
        if not (root / app["path"]).is_dir():
            missing.append(f"  {name}: {app['path']}")
    if missing:
        raise StationError("app path not found:\n" + "\n".join(missing))

    for name, app in config["apps"].items():
        if not app["git"]:
            continue
        directory = root / app["path"]
        if directory.exists():
            if not directory.is_dir():
                raise StationError(f"{name}: {app['path']} is not a directory")
            continue
        directory.parent.mkdir(parents=True, exist_ok=True)
        print(f"cloning {name}")
        code = run_command(["git", "clone", "--", app["git"], str(directory)])
        if code != 0:
            raise StationError(f"{name}: git clone failed")


def run_command(command: list[str]) -> int:
    try:
        completed = subprocess.run(command)
    except FileNotFoundError as error:
        program = command[0]
        raise StationError(f"{program} is required") from error
    return completed.returncode


def generate(root: Path, config: dict[str, Any]) -> None:
    if config["apps"]:
        write_file(root / "deployments" / "docker" / "Dockerfile.app", dockerfile_app())
        write_file(root / "deployments" / "docker" / "run-app.sh", run_app_script(), executable=True)
    for environment in ENVIRONMENTS:
        directory = root / "deployments" / environment
        write_file(directory / "docker-compose.yml", compose_yaml(config, environment))
        write_file(directory / "vault.hcl", vault_hcl())
        write_file(directory / "run-vault.sh", run_vault_script(config, environment), executable=True)
        write_file(directory / "openbao-agent.hcl", agent_hcl(config, environment))
        write_file(directory / "run-openbao-agent.sh", run_agent_script(config), executable=True)
        write_file(directory / "init-databases.sh", init_databases_script(config, environment), executable=True)


def write_file(path: Path, text: str, executable: bool = False) -> None:
    if not text.endswith("\n"):
        text += "\n"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8", newline="\n")
    path.chmod(0o755 if executable else 0o644)


def empty_manifest(name: str) -> str:
    return (
        f"name: {name}\n"
        'description: ""\n'
        "\n"
        "apps:\n"
        "\n"
        "db:\n"
        f"  image: {DEFAULT_DB_IMAGE}\n"
        "\n"
        "vault:\n"
        f"  image: {DEFAULT_VAULT_IMAGE}\n"
        "\n"
        "monitor:\n"
        "  agent: false\n"
        "  hub: false\n"
    )


def load_config(path: Path) -> dict[str, Any]:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise StationError(error.strerror or f"cannot read {path}") from error
    return normalize_config(parse_yaml(text, str(path)), str(path))


def normalize_config(data: dict[str, Any], source: str) -> dict[str, Any]:
    unknown = set(data) - {"name", "description", "apps", "db", "vault", "monitor"}
    if unknown:
        names = ", ".join(sorted(unknown))
        raise StationError(f"{source}: unknown keys: {names}")

    if "name" not in data or not isinstance(data["name"], str):
        raise StationError(f"{source}: name is required")
    validate_name(data["name"], "project name")

    description = data.get("description", "")
    if not isinstance(description, str):
        raise StationError(f"{source}: description must be a string")

    raw_apps = data.get("apps", {})
    if not isinstance(raw_apps, dict):
        raise StationError(f"{source}: apps must be a mapping")
    apps: dict[str, dict[str, str]] = {}
    for name, spec in raw_apps.items():
        validate_name(name, "application name")
        if not isinstance(spec, dict):
            raise StationError(f"{source}: {name} must be a mapping")
        extra = set(spec) - {"path", "git"}
        if extra:
            raise StationError(f"{source}: {name}: unknown keys: {', '.join(sorted(extra))}")
        has_path = "path" in spec
        has_git = "git" in spec
        if has_path == has_git:
            raise StationError(f"{source}: {name}: set either path or git")
        if has_path:
            if not isinstance(spec["path"], str):
                raise StationError(f"{source}: {name}: path must be a string")
            apps[name] = {"path": relative_path(spec["path"], f"{source}: {name}"), "git": ""}
        else:
            if not isinstance(spec["git"], str):
                raise StationError(f"{source}: {name}: git must be a string")
            git_url = spec["git"]
            if not git_url.startswith("https://") or any(character.isspace() for character in git_url):
                raise StationError(f"{source}: {name}: git must be an https URL")
            apps[name] = {"path": f"apps/{name}", "git": git_url}

    return {
        "name": data["name"],
        "description": description,
        "apps": apps,
        "db_image": section_image(data, "db", DEFAULT_DB_IMAGE, source),
        "vault_image": section_image(data, "vault", DEFAULT_VAULT_IMAGE, source),
        "monitor": monitor_flags(data, source),
    }


def section_image(data: dict[str, Any], key: str, default: str, source: str) -> str:
    if key not in data:
        return default
    section = data[key]
    if not isinstance(section, dict):
        raise StationError(f"{source}: {key} must be a mapping")
    extra = set(section) - {"image"}
    if extra:
        raise StationError(f"{source}: {key}: unknown keys: {', '.join(sorted(extra))}")
    image = section.get("image", default)
    if not isinstance(image, str) or not IMAGE_PATTERN.fullmatch(image):
        raise StationError(f"{source}: {key}.image is not a valid image reference")
    return image


def monitor_flags(data: dict[str, Any], source: str) -> dict[str, bool]:
    flags = {"agent": False, "hub": False}
    if "monitor" not in data:
        return flags
    section = data["monitor"]
    if not isinstance(section, dict):
        raise StationError(f"{source}: monitor must be a mapping")
    extra = set(section) - {"agent", "hub"}
    if extra:
        raise StationError(f"{source}: monitor: unknown keys: {', '.join(sorted(extra))}")
    for key in ("agent", "hub"):
        if key not in section:
            continue
        if not isinstance(section[key], bool):
            raise StationError(f"{source}: monitor.{key} must be true or false")
        flags[key] = section[key]
    return flags


def validate_name(value: str, label: str) -> None:
    if not isinstance(value, str) or not NAME_PATTERN.fullmatch(value):
        raise StationError(f"{label} must be lowercase with underscores: {value}")


def relative_path(value: str, label: str) -> str:
    path = Path(value)
    if path.is_absolute() or "\\" in value or not value.strip():
        raise StationError(f"{label}: path must be relative to the project")
    parts = path.parts
    if any(part in ("", ".", "..") for part in parts):
        raise StationError(f"{label}: path must stay inside the project")
    return path.as_posix()


def parse_yaml(text: str, source: str) -> dict[str, Any]:
    tokens: list[tuple[int, int, str]] = []
    for number, raw in enumerate(text.splitlines(), 1):
        raw = raw.rstrip("\r")
        if "\t" in raw:
            raise StationError(f"{source}:{number}: tabs are not allowed")
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        tokens.append((number, indent, stripped))
    if not tokens:
        raise StationError(f"{source}: file is empty")
    parsed, index = parse_mapping(tokens, 0, 0, source)
    if index != len(tokens):
        raise StationError(f"{source}:{tokens[index][0]}: unexpected content")
    if not isinstance(parsed, dict):
        raise StationError(f"{source}: expected a mapping")
    return parsed


def parse_mapping(
    tokens: list[tuple[int, int, str]],
    index: int,
    indent: int,
    source: str,
) -> tuple[dict[str, Any], int]:
    result: dict[str, Any] = {}
    while index < len(tokens):
        number, token_indent, text = tokens[index]
        if token_indent < indent:
            break
        if token_indent > indent:
            raise StationError(f"{source}:{number}: unexpected indent")
        key, separator, remainder = text.partition(":")
        key = key.strip()
        if not separator or not KEY_PATTERN.fullmatch(key):
            raise StationError(f"{source}:{number}: expected a key")
        if key in result:
            raise StationError(f"{source}:{number}: duplicate key: {key}")
        remainder = remainder.strip()
        index += 1
        if remainder == "":
            if index < len(tokens) and tokens[index][1] > token_indent:
                value, index = parse_mapping(tokens, index, tokens[index][1], source)
            else:
                value = {}
        elif remainder == "{}":
            value = {}
        else:
            value = parse_scalar(remainder, source, number)
        result[key] = value
    return result, index


def parse_scalar(value: str, source: str, number: int) -> Any:
    if value in ("true", "false"):
        return value == "true"
    if value[:1] in ("'", '"'):
        quote = value[0]
        if len(value) < 2 or value[-1] != quote:
            raise StationError(f"{source}:{number}: unterminated string")
        body = value[1:-1]
        if quote == '"':
            return body.replace('\\"', '"').replace("\\\\", "\\")
        return body.replace("\\'", "'").replace("\\\\", "\\")
    return value


def compose_yaml(config: dict[str, Any], environment: str) -> str:
    project = config["name"]
    ports = HOST_PORTS[environment]
    lines = [
        f"# {GENERATED}",
        f"# Environment: {environment}",
        "",
        f"name: {project}-{environment}",
        "",
        "x-station-monitor:",
        f"  agent: {str(config['monitor']['agent']).lower()}",
        f"  hub: {str(config['monitor']['hub']).lower()}",
        "",
        "services:",
        "  vault:",
        f"    image: {config['vault_image']}",
        f"    container_name: {project}-vault-{environment}",
        '    user: "0"',
        "    ports:",
        f'      - "127.0.0.1:{ports["vault"]}:8200"',
        "    environment:",
        '      VAULT_ADDR: "http://127.0.0.1:8200"',
        "    volumes:",
        "      - vault-data:/openbao/file",
        "      - ./vault.hcl:/openbao/config/vault.hcl:ro",
        "      - ./run-vault.sh:/openbao/config/run-vault.sh:ro",
        "    entrypoint: [\"/bin/sh\", \"/openbao/config/run-vault.sh\"]",
        "    healthcheck:",
        '      test: ["CMD", "bao", "status"]',
        "      interval: 5s",
        "      timeout: 3s",
        "      retries: 12",
        "      start_period: 5s",
        "    networks:",
        "      - internal",
        "",
        "  vault-agent:",
        f"    image: {config['vault_image']}",
        f"    container_name: {project}-vault-agent-{environment}",
        "    depends_on:",
        "      vault:",
        "        condition: service_healthy",
        "    environment:",
        '      VAULT_ADDR: "http://vault:8200"',
        '      VAULT_DEV_ROOT_TOKEN_ID: "root"',
        "    volumes:",
        "      - db-secrets:/run/db-secrets",
    ]
    for name in config["apps"]:
        lines.append(f"      - {name}-secrets:/run/secrets/{name}")
    lines.extend([
        "      - ./openbao-agent.hcl:/openbao/config/agent.hcl:ro",
        "      - ./run-openbao-agent.sh:/openbao/config/run-openbao-agent.sh:ro",
        "    entrypoint: [\"/bin/sh\", \"/openbao/config/run-openbao-agent.sh\"]",
        "    networks:",
        "      - internal",
        "",
        "  db:",
        f"    container_name: {project}-db-{environment}",
        f"    image: {config['db_image']}",
        "    restart: unless-stopped",
        "    depends_on:",
        "      vault-agent:",
        "        condition: service_started",
        "    environment:",
        "      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_passwd",
        "    volumes:",
        "      - db-data:/var/lib/postgresql",
        "      - db-secrets:/run/secrets:ro",
        "      - ./init-databases.sh:/docker-entrypoint-initdb.d/init-databases.sh:ro",
        "    logging:",
        '      driver: "json-file"',
        "      options:",
        "        max-file: 5",
        "        max-size: 10m",
        "    networks:",
        "      - internal",
        "    ports:",
        f'      - "127.0.0.1:{ports["db"]}:5432"',
    ])

    for index, (name, app) in enumerate(config["apps"].items()):
        database = f"{project}_{name}_{environment}"
        lines.extend([
            "",
            f"  {name}:",
            f"    container_name: {project}-{name}-{environment}",
            "    depends_on:",
            "      db:",
            "        condition: service_started",
            "      vault-agent:",
            "        condition: service_started",
            "    build:",
            "      context: ../..",
            "      dockerfile: deployments/docker/Dockerfile.app",
            "      args:",
            f"        STATION_APP: {app['path']}",
            "    ports:",
            f'      - "127.0.0.1:{ports["app"] + index}:80"',
            "    environment:",
            '      PORT: "80"',
            '      VAULT_ADDR: "http://vault:8200"',
            "      PGHOST: db",
            '      PGPORT: "5432"',
            "      PGUSER: postgres",
            f"      PGDATABASE: {database}",
            "    volumes:",
            f"      - {name}-secrets:/run/secrets:ro",
            "    networks:",
            "      - internal",
        ])

    lines.extend([
        "",
        "volumes:",
        "  db-data:",
        "  vault-data:",
    ])
    lines.extend(secret_volume("db-secrets"))
    for name in config["apps"]:
        lines.extend(secret_volume(f"{name}-secrets"))
    lines.extend([
        "",
        "networks:",
        "  internal:",
        "    driver: bridge",
    ])
    return "\n".join(lines) + "\n"


def secret_volume(name: str) -> list[str]:
    return [
        f"  {name}:",
        "    driver: local",
        "    driver_opts:",
        "      type: tmpfs",
        "      device: tmpfs",
        "      o: size=16m,mode=0777",
    ]


def vault_hcl() -> str:
    return f"""\
# {GENERATED}

ui = true

storage "raft" {{
  path    = "/openbao/file/raft"
  node_id = "node1"
}}

listener "tcp" {{
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_disable     = true
}}

api_addr     = "http://127.0.0.1:8200"
cluster_addr = "http://127.0.0.1:8201"
"""


def agent_hcl(config: dict[str, Any], environment: str) -> str:
    blocks = [
        f"# {GENERATED}",
        "",
        'pid_file = "/tmp/openbao-agent.pid"',
        "",
        "vault {",
        '  address = "http://vault:8200"',
        "}",
        "",
        "auto_auth {",
        "  method {",
        '    type = "token_file"',
        "    config = {",
        '      token_file_path = "/tmp/vault-token"',
        "    }",
        "  }",
        "}",
        "",
        "template_config {",
        '  static_secret_render_interval = "1m"',
        "  exit_on_retry_failure         = false",
        "}",
        "",
        secret_template("platform", f"{config['name']}-platform-{environment}", "/run/db-secrets"),
    ]
    for name in config["apps"]:
        vault_name = f"{config['name']}-{name}-{environment}"
        platform_path = f"{config['name']}-platform-{environment}"
        directory = f"/run/secrets/{name}"
        blocks.append(secret_template(f"{name}-platform", platform_path, directory))
        blocks.append(secret_template(f"{name}-own", vault_name, directory))
    return "\n".join(blocks)


def secret_template(marker: str, secret_path: str, directory: str) -> str:
    contents = (
        '{{ with secret \\"secret/data/' + secret_path + '\\" }}'
        '{{ range $k, $v := .Data.data }}'
        '{{ $v | writeToFile (printf \\"' + directory + '/%s\\" $k) \\"\\" \\"\\" \\"0644\\" }}'
        '{{ end }}{{ end }}'
    )
    return "\n".join([
        "template {",
        f'  destination = "/tmp/.rendered-{marker}"',
        f'  contents    = "{contents}"',
        "}",
        "",
    ])


def run_agent_script(config: dict[str, Any]) -> str:
    directories = " ".join(
        ["/run/db-secrets"] + [f"/run/secrets/{name}" for name in config["apps"]]
    )
    chmod_targets = "/run/db-secrets/*"
    if config["apps"]:
        chmod_targets += " /run/secrets/*/*"
    return f"""\
#!/bin/sh
# {GENERATED}
set -eu

printf '%s' "${{VAULT_DEV_ROOT_TOKEN_ID}}" > /tmp/vault-token
chmod 600 /tmp/vault-token

# writeToFile opens the destination for rewrite; 0444 files from earlier
# renders cause "permission denied" on the next template cycle.
mkdir -p {directories}
chmod u+w {chmod_targets} 2>/dev/null || true

exec /usr/local/bin/docker-entrypoint.sh agent -config=/openbao/config/agent.hcl
"""


def init_databases_script(config: dict[str, Any], environment: str) -> str:
    databases = [
        f"{config['name']}_{name}_{environment}"
        for name in config["apps"]
    ]
    if not databases:
        return f"""\
#!/bin/sh
# {GENERATED}
set -eu
exit 0
"""
    statements = "\n".join(f"CREATE DATABASE {name};" for name in databases)
    return f"""\
#!/bin/sh
# {GENERATED}
set -eu

psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname postgres <<'SQL'
{statements}
SQL
"""


def run_vault_script(config: dict[str, Any], environment: str) -> str:
    calls = []
    for name in config["apps"]:
        calls.append(f'  bootstrap_app "{config["name"]}-{name}-{environment}"')
    app_setup = "\n".join(calls)
    if app_setup:
        app_block = f"""
  if ! VAULT_TOKEN="$token" bao auth list -format=json 2>/dev/null | grep -q '"approle/"'; then
    VAULT_TOKEN="$token" bao auth enable approle
  fi
{app_setup}
"""
    else:
        app_block = ""

    function = ""
    if config["apps"]:
        platform_path = f"{config['name']}-platform-{environment}"
        function = f"""
bootstrap_app() {{
  vault_name="$1"
  cat > /tmp/app-policy.hcl <<EOF
path "secret/data/{platform_path}" {{
  capabilities = ["read"]
}}
path "secret/metadata/{platform_path}" {{
  capabilities = ["read"]
}}
path "secret/data/${{vault_name}}" {{
  capabilities = ["read"]
}}
path "secret/metadata/${{vault_name}}" {{
  capabilities = ["read"]
}}
EOF
  VAULT_TOKEN="$token" bao policy write "$vault_name" /tmp/app-policy.hcl
  VAULT_TOKEN="$token" bao write "auth/approle/role/${{vault_name}}" \\
    token_ttl=1h \\
    token_max_ttl=24h \\
    token_num_uses=0 \\
    secret_id_ttl=0 \\
    secret_id_num_uses=0 \\
    token_policies="default,${{vault_name}}"

  role_id=$(VAULT_TOKEN="$token" bao read -field=role_id "auth/approle/role/${{vault_name}}/role-id")
  secret_id=$(VAULT_TOKEN="$token" bao write -f -field=secret_id "auth/approle/role/${{vault_name}}/secret-id")
  if ! VAULT_TOKEN="$token" bao kv patch "secret/${{vault_name}}" \\
    approle_role_id="$role_id" \\
    approle_secret_id="$secret_id"; then
    VAULT_TOKEN="$token" bao kv put "secret/${{vault_name}}" \\
      approle_role_id="$role_id" \\
      approle_secret_id="$secret_id"
  fi
}}
"""

    return f"""\
#!/bin/sh
# {GENERATED}
set -eu

echo "*** Executing run-vault.sh"

export VAULT_ADDR="${{VAULT_ADDR:-http://127.0.0.1:8200}}"

DATA_DIR=/openbao/file
UNSEAL_KEY_FILE="${{DATA_DIR}}/unseal-key"
INIT_ROOT_TOKEN_FILE="${{DATA_DIR}}/init-root-token"
ROOT_TOKEN_ID="${{VAULT_DEV_ROOT_TOKEN_ID:-root}}"

mkdir -p "${{DATA_DIR}}/data" "${{DATA_DIR}}/raft"
file_data=$(ls -A "${{DATA_DIR}}/data" 2>/dev/null || true)
raft_data=$(ls -A "${{DATA_DIR}}/raft" 2>/dev/null || true)
if [ -n "$file_data" ] && [ -z "$raft_data" ]; then
  cat > /tmp/migrate.hcl <<EOF
storage_source "file" {{
  path = "${{DATA_DIR}}/data"
}}
storage_destination "raft" {{
  path    = "${{DATA_DIR}}/raft"
  node_id = "node1"
}}
cluster_addr = "http://127.0.0.1:8201"
EOF
  echo "*** Migrating file storage to raft"
  bao operator migrate -config=/tmp/migrate.hcl
fi
chown -R openbao:openbao "${{DATA_DIR}}"

su-exec openbao bao server -config=/openbao/config/vault.hcl &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null || true; wait "$pid"' INT TERM

while true; do
  rc=0
  bao status >/dev/null 2>&1 || rc=$?
  if [ "$rc" = "0" ] || [ "$rc" = "2" ]; then
    break
  fi
  sleep 0.25
done

status_json=$(bao status -format=json 2>/dev/null || true)

if ! echo "$status_json" | grep -q '"initialized"[[:space:]]*:[[:space:]]*true'; then
  init_out=$(bao operator init -key-shares=1 -key-threshold=1 -format=json)
  compact=$(printf '%s' "$init_out" | tr -d '\\n')
  printf '%s' "$compact" | sed -n 's/.*"unseal_keys_b64"[[:space:]]*:[[:space:]]*\\[[[:space:]]*"\\([^"]*\\)".*/\\1/p' > "$UNSEAL_KEY_FILE"
  printf '%s' "$compact" | sed -n 's/.*"root_token"[[:space:]]*:[[:space:]]*"\\([^"]*\\)".*/\\1/p' > "$INIT_ROOT_TOKEN_FILE"
  chmod 600 "$UNSEAL_KEY_FILE" "$INIT_ROOT_TOKEN_FILE"
  chown openbao:openbao "$UNSEAL_KEY_FILE" "$INIT_ROOT_TOKEN_FILE"
  if [ ! -s "$UNSEAL_KEY_FILE" ] || [ ! -s "$INIT_ROOT_TOKEN_FILE" ]; then
    echo "failed to parse operator init output" >&2
    echo "$init_out" >&2
    exit 1
  fi
fi

if [ -f "$UNSEAL_KEY_FILE" ]; then
  bao operator unseal "$(cat "$UNSEAL_KEY_FILE")" >/dev/null
fi
{function}
if [ -f "$INIT_ROOT_TOKEN_FILE" ]; then
  token=$(cat "$INIT_ROOT_TOKEN_FILE")
  if ! VAULT_TOKEN="$token" bao secrets list -format=json 2>/dev/null | grep -q '"secret/"'; then
    VAULT_TOKEN="$token" bao secrets enable -path=secret kv-v2
  fi
  if ! VAULT_TOKEN="$token" bao token lookup "$ROOT_TOKEN_ID" >/dev/null 2>&1; then
    VAULT_TOKEN="$token" bao token create -id="$ROOT_TOKEN_ID" -policy=root -orphan >/dev/null
  fi
{app_block}fi

wait "$pid"
"""


def dockerfile_app() -> str:
    path = Path(__file__).resolve().parent.parent / "docker" / "Dockerfile.app"
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise StationError(error.strerror or f"cannot read {path}") from error
    banner = f"# {GENERATED}\n"
    if not text.startswith(banner):
        text = banner + text
    return text


def run_app_script() -> str:
    return f"""\
#!/bin/sh
# {GENERATED}

# Watchdog for an app container.
# Run npm install on startup for the sake of platform-sensitive packages.
npm install

# execute migrations once database is up
npm run create
until npm run migrate
do
npm run create
done

while true; do
    npm run http
    echo "Process exited with code $?.  Respawning.." >&2
    sleep 1
done
"""


if __name__ == "__main__":
    sys.exit(main(sys.argv))
